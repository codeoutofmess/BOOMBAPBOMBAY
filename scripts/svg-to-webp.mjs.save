import sharp from "sharp";
import fs from "fs/promises";
import path from "path";

const SRC_DIR = path.resolve("src/assets");

async function getSvgFiles(dir) {
  const entries = await fs.readdir(dir, { withFileTypes: true });

  const files = await Promise.all(
    entries.map(async (entry) => {
      const fullPath = path.join(dir, entry.name);

      if (entry.isDirectory()) {
        return getSvgFiles(fullPath);
      }

      if (entry.isFile() && entry.name.toLowerCase().endsWith(".svg")) {
        return [fullPath];
      }

      return [];
    })
  );

  return files.flat();
}

const svgFiles = await getSvgFiles(SRC_DIR);

if (!svgFiles.length) {
  console.log("No SVG files found.");
  process.exit(0);
}

for (const file of svgFiles) {
  const output = file.replace(/\.svg$/i, ".webp");

  await sharp(file)
    .webp({ quality: 90 })
    .toFile(output);

  console.log(`Converted: ${path.relative(process.cwd(), file)} → ${path.relative(process.cwd(), output)}`);
}

console.log(`Done. Converted ${svgFiles.length} SVG files.`);
